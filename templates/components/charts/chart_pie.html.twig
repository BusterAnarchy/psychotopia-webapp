{% set legend_id = id ~ '_legend' %}

<div class="chart-wrapper">
    <div class="chart-wrapper__canvas">
        <canvas id="{{ id }}" class="chart-canvas"></canvas>
    </div>
    <div id="{{ legend_id }}" class="chart-html-legend chart-wrapper__legend" aria-label="Legende du graphique" hidden></div>
    {% include "components/charts/chart_data_table.html.twig" with {
        chart_id: id,
        chart_data_json: chart_data,
        table_config: {
            type: 'categorical',
            labelsKey: 'labels',
            dataKey: 'data',
            labelHeading: 'Catégorie',
            valueHeading: 'Valeur'
        }
    } %}
</div>

<script>
    (function() {
        const legendId = '{{ legend_id }}';
        const data = {{ chart_data | raw }};
        const htmlLegendPlugin = typeof window.createChartHtmlLegendPlugin === 'function'
            ? window.createChartHtmlLegendPlugin()
            : null;

        new Chart(document.getElementById('{{ id }}').getContext('2d'), {
            type: 'pie',
            plugins: htmlLegendPlugin ? [htmlLegendPlugin] : [],
            data: {
                labels: data.labels.slice().reverse(),
                datasets: [{
                    data: data.data.slice().reverse(),
                    backgroundColor: Chart.defaults.colorPalette.map(color => color + 'BB'),
                    borderColor: Chart.defaults.colorPalette,
                }]
            },
            options: {
                responsive : true,
                maintainAspectRatio: false,
                plugins: {
                    htmlLegend: {
                        containerID: legendId
                    },
                    legend: {
                        display: !htmlLegendPlugin,
                        position: 'bottom',
                        align: 'center',
                        labels: {
                            usePointStyle: true,
                            pointStyle: 'circle',
                            boxWidth: 12,
                            boxHeight: 12,
                            padding: 12
                        }
                    }
                }
            }
        });
        
    })();
</script>
